{
  "name": "medical-records-download",
  "private": true,
  "type": "module",
  "description": "Downloads the old VetAssist system's medical records (one zip per pet) and reads its appointments list.",
  "scripts": {
    "test-run": "node download.mjs --test",
    "start": "node download.mjs",
    "appointments-test": "node appointments.mjs --pages 1",
    "appointments": "node appointments.mjs",
    "services-test": "node services.mjs --limit 3",
    "services": "node services.mjs",
    "records-test": "node records.mjs --limit 20",
    "records": "node records.mjs",
    "photos-test": "node photos.mjs --limit 20",
    "photos": "node photos.mjs",
    "medications-test": "node medications.mjs --limit 3",
    "medications": "node medications.mjs"
  },
  "dependencies": {
    "playwright-core": "1.63.0",
    "pdfjs-dist": "4.10.38",
    "adm-zip": "0.5.16",
    "pdf-lib": "1.17.1"
  }
}
