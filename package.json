{
  "name": "hanna-clinic-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply hanna-clinic --local",
    "db:migrate:remote": "wrangler d1 migrations apply hanna-clinic --remote",
    "import:legacy": "node scripts/import-legacy.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
